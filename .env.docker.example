# Absolute host path to the project Athena should index.
ATHENA_WORKSPACE=D:/projects/my-project

# Use one unique Docker volume per project.
ATHENA_VOLUME_NAME=athena-my-project

# Local build or Docker Hub image.
ATHENA_IMAGE=athena-codegraph:local
ATHENA_VERSION=0.2.0

ATHENA_MCP_HOST=codex
ATHENA_MEMORY_LIMIT=1g
ATHENA_CPU_LIMIT=2.0
